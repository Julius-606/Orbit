# ==============================================================================
# 🪐 PROJECT ORBIT + GLUK DEBATEHUB UNIFIED ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file provides a complete, production-ready template for configuring both:
#  1) Project Orbit (FastAPI Trading Brain on Port 7860)
#  2) DebateHub (Independent Express/Vite/Neon Backend on Port 3000)
#
# USAGE INSTRUCTIONS:
#  - Local Development: Copy this file to `.env` in the root and in `backend/DebateHub/.env`.
#  - Hugging Face Spaces: Add these variables under Space Settings -> "Variables and secrets".
# ==============================================================================

# ------------------------------------------------------------------------------
# 🏛️ SECTION 1: DEBATEHUB INDEPENDENT BACKEND (POSTGRESQL & AI)
# ------------------------------------------------------------------------------

# DEBATEHUB_NEON_DATABASE_URL:
# Dedicated PostgreSQL connection string from Neon (https://neon.tech) for DebateHub.
# This database stores GLUK Debate Club members, finances, debate sessions, agendas,
# announcements, calendar events, and alumni mentorship records.
#
# 💡 PRO TIP FOR NEON DB:
#  1. In Neon Console (neon.tech) -> Dashboard -> Connection Details:
#     Select "Pooled connection" checkbox to use the PgBouncer pooler endpoint.
#  2. Ensure the hostname contains `-pooler` (e.g. ep-xyz-pooler.us-east-2.aws.neon.tech).
#  3. Always include `?sslmode=require` at the end of the URL.
#
# Example Format:
# postgresql://<user>:<password>@ep-debatehub-pool-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DEBATEHUB_NEON_DATABASE_URL="postgresql://debatehub_user:YourSecureNeonPassword@ep-debatehub-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Fallback alias for DebateHub (if DEBATEHUB_NEON_DATABASE_URL is not set):
NEON_DATABASE_URL=""

# Port for DebateHub's internal Express/Vite server (Default: 3000)
# Orbit proxies traffic from https://agent606-orbit.hf.space/debatehub -> http://127.0.0.1:3000
PORT=3000
DEBATEHUB_PORT=3000

# Base URL path for DebateHub frontend assets (Vite base)
# Keep as /debatehub/ so static JS, CSS, and SPA routing align with the proxy gateway
VITE_BASE="/debatehub/"

# Comma-separated Gemini API keys. The backend rotates after quota/auth failures.
GEMINI_API_KEYS=""

# Development HMR setting: set to 'true' in CI/agent test containers to disable watching
DISABLE_HMR="false"


# ------------------------------------------------------------------------------
# 🪐 SECTION 2: PROJECT ORBIT (FASTAPI CORE & TRADING BRAIN)
# ------------------------------------------------------------------------------

# DATABASE_URL:
# Primary PostgreSQL database connection for Project Orbit trading accounts and tasks.
# Can point to a dedicated Orbit Neon DB database or a local PostgreSQL instance.
# Note: For async SQLAlchemy, Orbit automatically translates this to postgresql+asyncpg://
DATABASE_URL="postgresql://orbit_user:YourOrbitPassword@ep-orbit-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Orbit Internal Proxy Target for DebateHub (Default: http://127.0.0.1:3000)
DEBATEHUB_INTERNAL_URL="http://127.0.0.1:3000"

# Application Metadata & Security
PROJECT_NAME="Orbit Brain"
VERSION="2.0.0"

# JWT Secret Key for API token generation and signature verification
# Generate a secure 32+ character random hex string: openssl rand -hex 32
SECRET_KEY="replace-with-a-very-strong-cryptographic-random-secret-key-32-chars-min"
ALGORITHM="HS256"

# Header token for administrative API requests and webhook automation
ORBIT_SECRET_TOKEN="orbit-secure-admin-token-xyz"

# Optional Redis Cache / Task Queue (leave blank if running purely in-memory)
REDIS_URL=""


# ------------------------------------------------------------------------------
# 📈 SECTION 3: METATRADER 5 (MT5) TRADING GATEWAY
# ------------------------------------------------------------------------------
# Used by Project Orbit's Forex and liquidity analysis execution engines:
MT5_LOGIN=""
MT5_PASSWORD=""
MT5_SERVER=""


# ------------------------------------------------------------------------------
# 🌐 SECTION 4: PUBLIC ACCESS & ENVIRONMENT HOSTS
# ------------------------------------------------------------------------------
# Public Hugging Face Space URL:
BASE_URL_HF="https://agent606-orbit.hf.space"

# Local test host:
BASE_URL_LOCAL="http://localhost:7860"

# Optional Ngrok public tunnel host for local webhook testing:
BASE_URL_NGROK=""


# ==============================================================================
# 🛠️ NEON DATABASE TROUBLESHOOTING & FAQ
# ==============================================================================
#
# Q1: What URL do I use to access DebateHub?
# A1: https://agent606-orbit.hf.space/debatehub
#     FastAPI automatically handles trailing slashes, proxying sub-paths, and Vite assets.
#
# Q2: Why did test announcements and calendar events not appear in Neon DB?
# A2: When the connection to Neon times out, DebateHub's backend catches the error
#     and safely writes the data to the local `database.json` fallback so your UI
#     continues working smoothly without crashing.
#     To push all your local announcements and calendar events into Neon:
#     1) Ensure your Neon compute is active.
#     2) Open DebateHub -> Click the Database status icon (or Neon modal).
#     3) Click "Sync Offline Data to Neon" or "Initialize Tables in Neon".
#     This immediately syncs all announcements, calendar events, members, and debates to Neon!
#
# Q3: What causes "TypeError: fetch failed" with "AggregateError [ETIMEDOUT]"?
# A3: 1) Neon Compute Cold Start: Free-tier Neon databases pause after 5 minutes of inactivity.
#        The first query takes 2-4 seconds to wake up the compute instance.
#     2) IPv6 / Node.js Happy Eyeballs: In Node 18+ on Linux, `fetch()` tries IPv6 first.
#        If your network does not route IPv6, it times out before trying IPv4.
#        DebateHub now includes an automatic circuit breaker and IPv4 priority to prevent UI freezing.
#     3) Missing -pooler: Always use the pooled connection string (with -pooler in the hostname).
#     4) Missing sslmode: Make sure `?sslmode=require` is present at the end of the URL.
# ==============================================================================
