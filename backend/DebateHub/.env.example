# ==============================================================================
# DebateHub Environment Secrets (Independent Neon Database)
# ==============================================================================

# DEBATEHUB_NEON_DATABASE_URL: Dedicated PostgreSQL connection string from Neon for DebateHub
# This is completely independent from Orbit's DATABASE_URL.
# Configure this in Hugging Face Space Secrets or .env:
DEBATEHUB_NEON_DATABASE_URL="postgresql://user:password@ep-debatehub-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Fallback (optional):
NEON_DATABASE_URL=""

# GEMINI_API_KEY: Optional Gemini API key for debate drills and motions
GEMINI_API_KEY=""

# Port for DebateHub internal server (default 3000)
PORT=3000
DEBATEHUB_PORT=3000
