ORBIT_SECRET_TOKEN=3ATLNDwN6SfiTQfyfEjxQpxsRtj_6dzR8QzKxpXeZn8Nn76n4

# --- Networking Fallback URLs ---
# Found in: RetrofitClient.kt

# Local Emulator URL (usually http://10.0.2.2:8000/)
BASE_URL_LOCAL=http://10.0.2.2:8000/

# Ngrok Fallback URL (e.g., https://your-id.ngrok-free.app/)
BASE_URL_NGROK=https://YOUR_NGROK_ID.ngrok-free.app/

# Hugging Face Space URL (e.g., https://your-space.hf.space/)
